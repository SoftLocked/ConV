{
	log default {
		format filter {
			wrap json
			fields {
				request>uri replace REDACTED
			}
		}
	}
}

{$CONV_HOST:localhost} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@metadata path /signal /ice /health
	reverse_proxy @metadata signaling:3001
	root * /srv
	try_files {path} /index.html
	file_server
}
